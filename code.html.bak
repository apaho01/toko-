<!DOCTYPE html>

<html class="dark" lang="en"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><meta content="web_standard" name="shell-type"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;family=Space+Grotesk:wght@500;600;700&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{"colors":{"on-surface-variant":"#cbc3d7","surface-container-low":"#1b1b21","on-tertiary-container":"#002f38","surface-tint":"#d0bcff","inverse-primary":"#6d3bd7","on-tertiary":"#003640","on-error":"#690005","inverse-surface":"#e4e1ea","on-primary-container":"#340080","surface-container":"#1f1f25","secondary":"#d2bbff","on-secondary-container":"#c9aeff","surface-container-highest":"#34343b","on-tertiary-fixed-variant":"#004e5c","inverse-on-surface":"#303036","on-surface":"#e4e1ea","tertiary-container":"#009eb9","surface-bright":"#39383f","on-primary-fixed":"#23005c","on-secondary-fixed":"#25005a","secondary-fixed":"#eaddff","outline-variant":"#494454","on-secondary-fixed-variant":"#5a00c6","surface-variant":"#34343b","outline":"#958ea0","secondary-fixed-dim":"#d2bbff","surface-container-lowest":"#0e0e14","tertiary-fixed":"#acedff","primary-fixed-dim":"#d0bcff","primary":"#d0bcff","tertiary-fixed-dim":"#4cd7f6","background":"#131319","primary-fixed":"#e9ddff","on-error-container":"#ffdad6","on-primary-fixed-variant":"#5516be","tertiary":"#4cd7f6","on-primary":"#3c0091","primary-container":"#a078ff","on-tertiary-fixed":"#001f26","on-secondary":"#3f008e","error":"#ffb4ab","on-background":"#e4e1ea","surface":"#131319","secondary-container":"#6001d1","surface-container-high":"#2a2930","error-container":"#93000a","surface-dim":"#131319"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"space-xl":"2.5rem","space-sm":"0.5rem","space-xs":"0.25rem","gutter-mobile":"1rem","margin":"3rem","margin-mobile":"1rem","space-md":"1rem","gutter":"1.5rem","space-lg":"1.5rem"},"fontFamily":{"label-md":["Space Grotesk"],"body-md":["Plus Jakarta Sans"],"headline-sm":["Space Grotesk"],"display-hero-mobile":["Space Grotesk"],"body-lg":["Plus Jakarta Sans"],"body-sm":["Plus Jakarta Sans"],"label-lg":["Space Grotesk"],"headline-lg-mobile":["Space Grotesk"],"display-hero":["Space Grotesk"],"headline-lg":["Space Grotesk"],"label-sm":["Space Grotesk"],"headline-md":["Space Grotesk"]},"fontSize":{"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0.06em","fontWeight":"600"}],"body-md":["15px",{"lineHeight":"24px","fontWeight":"400"}],"headline-sm":["20px",{"lineHeight":"28px","fontWeight":"600"}],"display-hero-mobile":["36px",{"lineHeight":"44px","letterSpacing":"-0.02em","fontWeight":"700"}],"body-lg":["18px",{"lineHeight":"28px","fontWeight":"400"}],"body-sm":["13px",{"lineHeight":"20px","fontWeight":"400"}],"label-lg":["14px",{"lineHeight":"20px","letterSpacing":"0.05em","fontWeight":"600"}],"headline-lg-mobile":["28px",{"lineHeight":"36px","letterSpacing":"-0.01em","fontWeight":"600"}],"display-hero":["56px",{"lineHeight":"64px","letterSpacing":"-0.03em","fontWeight":"700"}],"headline-lg":["36px",{"lineHeight":"44px","letterSpacing":"-0.02em","fontWeight":"600"}],"label-sm":["10px",{"lineHeight":"14px","letterSpacing":"0.08em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"600"}]}}}};</script></head><body class="bg-surface text-on-surface selection:bg-primary-container selection:text-on-primary-container"><div class="fixed top-0 left-0 w-full z-50"><div class="w-full bg-surface-container-lowest/90 backdrop-blur-md"><div class="max-w-7xl mx-auto px-6 lg:px-12 h-9 flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm tracking-widest uppercase"><div class="flex items-center gap-space-xs"><span class="text-tertiary">⚡</span><span class="text-on-surface">FREE OVERNIGHT SHIPPING ON RTX 4090 BUILDS</span><span class="text-outline">•</span><span>3-YEAR WARRANTY &amp; ON-SITE SUPPORT</span><span class="text-outline">•</span><span class="text-tertiary-fixed-dim">RIGS ASSEMBLED IN 48H</span></div><div class="hidden md:flex items-center gap-space-md"><span class="text-outline">EST. DISPATCH: TODAY 17:00 PST</span><a class="hover:text-primary transition-colors flex items-center gap-1" data-path="repair-service" href="#"><span class="material-symbols-outlined text-[14px]">build_circle</span>TRACK REPAIR</a></div></div></div><header class="w-full bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-sm"><img alt="UltraPC Brand Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1WYHMLGBPCgNSx4Ob5kMW7YLy8PT5pnyOGjirTeHVe0SgLqsGPAIvnJ25jndFTJgj3j4-iNWbuuqxsy42-2cCaQgz7BJeca9WmbbGvQhFWhGLwv7bx2UxbrsE5jGAIe_3ZU7GxuhU4rj6Ypzj_dWK9UiDMGyU-naDCb5un-ag9wf9qKjxUKiMnAdT10XVcSt8oFDTmoM707lGl40KExowlFHa6sbzLfJvz5XgSgt1BF1dZ2Vpx62tmHEEvy"/><a class="flex flex-col" data-path="home" href="#"><span class="font-headline-sm text-headline-sm tracking-wider uppercase text-on-surface font-bold leading-none">ULTRA<span class="text-primary">PC</span></span><span class="font-label-sm text-label-sm text-outline tracking-widest">CUSTOM RIG ATELIER</span></a></div><div class="flex-1 max-w-md hidden xl:block"><div class="relative flex items-center w-full"><span class="material-symbols-outlined absolute left-3 text-outline text-[18px]">search</span><input class="w-full bg-surface-container-low pl-10 pr-16 py-2 rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-high transition-all" placeholder="Search GPUs, custom rigs, cooling parts..." type="text"/><span class="absolute right-3 px-1.5 py-0.5 rounded bg-surface-container-highest font-label-sm text-label-sm text-on-surface-variant font-mono">Ctrl+K</span></div></div><div class="flex items-center gap-space-md"><a class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all font-label-md text-label-md" data-path="repair-service" href="#"><span class="material-symbols-outlined text-[18px] text-tertiary">handyman</span><span>Status</span></a><a class="hidden sm:flex items-center gap-2 p-1.5 rounded-lg hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-colors" data-path="account-overview" href="#"><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></a><a class="relative flex items-center gap-space-sm pl-3 pr-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high transition-all shadow-[0_0_15px_rgba(208,188,255,0.15)]" data-path="shopping-cart" href="#"><div class="relative flex items-center"><span class="material-symbols-outlined text-primary text-[20px]">shopping_bag</span><span class="absolute -top-2 -right-2 px-1.5 py-0.2 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm leading-none">2</span></div><div class="flex flex-col text-left"><span class="font-label-sm text-label-sm text-outline uppercase leading-none">Cart</span><span class="font-label-md text-label-md text-on-surface font-mono font-bold leading-none mt-1">$4,899</span></div></a></div></div><div class="w-full bg-surface-container-lowest/40"><div class="max-w-7xl mx-auto px-6 lg:px-12"><nav class="flex items-center gap-space-lg overflow-x-auto py-2.5" data-active-classes="text-primary font-bold"><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="pre-built-rigs" href="#">Pre-Built Rigs</a><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="custom-configurator" href="#">Custom Configurator</a><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="pc-components" href="#">PC Components</a><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="liquid-cooling" href="#">Liquid Cooling</a><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="peripherals" href="#">Peripherals</a><a class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-colors" data-path="repair-service" href="#">Repair &amp; Service</a></nav></div></div></header></div><main class="w-full pt-36 bg-surface"><div class="flex flex-col w-full">
<!-- AMBIENT PURPLE ATMOSPHERE OVERLAY -->
<div class="relative w-full overflow-hidden bg-surface">
<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[580px] bg-primary/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
<div class="absolute top-96 -left-32 w-[600px] h-[400px] bg-secondary-container/20 rounded-full blur-[130px] pointer-events-none -z-10"></div>
<div class="absolute top-[1400px] -right-32 w-[700px] h-[500px] bg-tertiary/10 rounded-full blur-[150px] pointer-events-none -z-10"></div>
<!-- 1. HERO SECTION: APEX HORIZON // RTX 4090 OC TITAN -->
<section class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-20">
<!-- Flagship Badge & Sub-header telemetry line -->
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high/80 backdrop-blur-md shadow-sm">
<span class="inline-block w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
<span class="font-label-sm text-label-sm tracking-widest text-primary font-bold uppercase">TIER 0 ENTHUSIAST RIG • HAND-CRAFTED • HARDLINE LIQUID COOLED</span>
</div>
<div class="flex items-center gap-6 font-label-sm text-label-sm text-on-surface-variant font-mono">
<span>CHASSIS SN: <span class="text-on-surface font-semibold">UPC-TITAN-094</span></span>
<span class="hidden sm:inline">|</span>
<span class="hidden sm:inline">THERMAL SPEC: <span class="text-tertiary font-semibold">DISTRO BLOCK EK-QUANTUM</span></span>
</div>
</div>
<!-- Hero Grid Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- Left: Product Story & Configurator Launch (7 cols) -->
<div class="lg:col-span-7 flex flex-col gap-6">
<div class="flex flex-col gap-2">
<span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Flagship Workstation &amp; Gaming Apex</span>
<h1 class="font-display-hero text-display-hero uppercase text-on-surface leading-none tracking-tight">
              APEX HORIZON <br/>
<span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-tertiary">RTX 4090 OC TITAN</span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mt-2 leading-relaxed">
              Uncompromising Power. Precision Liquid Cooled. Hand-built with custom sand-blasted acrylic manifolds, dual 480mm radiators, and hand-selected silicon binned for maximum sustained clock speeds under 24/7 hyper-load.
            </p>
</div>
<!-- Specs Chips Bento Bar -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-2">
<div class="flex flex-col p-3 rounded-lg bg-surface-container-low shadow-sm">
<span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Processor</span>
<span class="font-label-md text-label-md text-on-surface font-semibold mt-1">i9-14900KS</span>
<span class="font-body-sm text-body-sm text-tertiary">6.2 GHz Binned</span>
</div>
<div class="flex flex-col p-3 rounded-lg bg-surface-container-low shadow-sm">
<span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Graphics</span>
<span class="font-label-md text-label-md text-on-surface font-semibold mt-1">RTX 4090 24G</span>
<span class="font-body-sm text-body-sm text-primary">Waterblock OC</span>
</div>
<div class="flex flex-col p-3 rounded-lg bg-surface-container-low shadow-sm">
<span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">DDR5 RAM</span>
<span class="font-label-md text-label-md text-on-surface font-semibold mt-1">64GB 7200MHz</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">CL34 Low Latency</span>
</div>
<div class="flex flex-col p-3 rounded-lg bg-surface-container-low shadow-sm">
<span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Storage</span>
<span class="font-label-md text-label-md text-on-surface font-semibold mt-1">4TB Gen5 NVMe</span>
<span class="font-body-sm text-body-sm text-tertiary">14,000 MB/s</span>
</div>
</div>
<!-- Benchmark Telemetry Badges -->
<div class="grid grid-cols-3 gap-3">
<div class="flex flex-col justify-between p-3.5 rounded-lg bg-surface-container">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Cyberpunk 2077</span>
<span class="material-symbols-outlined text-primary text-[18px]">sports_esports</span>
</div>
<div class="mt-2">
<div class="font-headline-md text-headline-md font-mono text-on-surface font-bold">142 <span class="font-label-sm text-label-sm text-tertiary">FPS</span></div>
<span class="font-body-sm text-body-sm text-outline">4K Path Tracing + DLSS 3.5</span>
</div>
</div>
<div class="flex flex-col justify-between p-3.5 rounded-lg bg-surface-container">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase">3DMark TimeSpy</span>
<span class="material-symbols-outlined text-secondary text-[18px]">speed</span>
</div>
<div class="mt-2">
<div class="font-headline-md text-headline-md font-mono text-on-surface font-bold">38,950</div>
<span class="font-body-sm text-body-sm text-outline">Extreme Graphics Score</span>
</div>
</div>
<div class="flex flex-col justify-between p-3.5 rounded-lg bg-surface-container">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Core Thermals</span>
<span class="material-symbols-outlined text-tertiary text-[18px]">ac_unit</span>
</div>
<div class="mt-2">
<div class="font-headline-md text-headline-md font-mono text-tertiary font-bold">&lt; 58°C</div>
<span class="font-body-sm text-body-sm text-outline">Full Loop Stress Test</span>
</div>
</div>
</div>
<!-- Price & Dual Action Deploy Bar -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 p-4 rounded-xl bg-surface-container-high/60 backdrop-blur-md shadow-md mt-2">
<div class="flex flex-col">
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg font-bold font-mono text-on-surface">$5,299</span>
<span class="font-label-md text-label-md text-outline">USD</span>
</div>
<span class="font-body-sm text-body-sm text-tertiary flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">credit_card</span>
                Or $249/mo with Affirm 0% APR in 24 installments
              </span>
</div>
<div class="flex items-center gap-3">
<button class="flex items-center gap-2 px-6 py-3.5 rounded-lg bg-gradient-to-r from-primary-container to-secondary-container text-on-primary font-label-lg text-label-lg uppercase tracking-wider font-bold shadow-[0_0_20px_rgba(139,92,246,0.40)] hover:brightness-110 hover:shadow-[0_0_30px_rgba(139,92,246,0.60)] transition-all" type="button">
<span>Configure &amp; Order</span>
<span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</button>
<button class="flex items-center gap-2 px-4 py-3.5 rounded-lg bg-surface-container-highest hover:bg-surface-bright text-on-surface font-label-md text-label-md uppercase tracking-wider font-semibold transition-colors" type="button">
<span class="material-symbols-outlined text-[18px]">analytics</span>
<span>Benchmarks</span>
</button>
</div>
</div>
</div>
<!-- Right: 3D-Angled PC Hardware Visualizer Card (5 cols) -->
<div class="lg:col-span-5 flex flex-col gap-4">
<div class="relative rounded-2xl bg-surface-container-low p-6 shadow-xl overflow-hidden group">
<!-- Lighting mode indicator ambient glow -->
<div class="absolute inset-0 bg-primary/10 rounded-2xl blur-2xl transition-all duration-700 pointer-events-none" id="ambientRgbGlow"></div>
<!-- Top Interactive HUD Bar -->
<div class="flex items-center justify-between mb-4 relative z-10">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
<span class="font-label-sm text-label-sm font-mono text-on-surface uppercase">LOOP STATUS: PRESSURIZED</span>
</div>
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface-container text-tertiary font-label-sm text-label-sm font-mono">
<span class="material-symbols-outlined text-[14px]">water_drop</span>
<span id="flowRate">3.8 L/MIN FLOW</span>
</div>
</div>
<!-- Rig Hardware Visual Frame -->
<div class="relative w-full h-[380px] rounded-xl overflow-hidden bg-surface-container-lowest flex items-center justify-center">
<img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" data-alt="Monolithic custom enthusiast desktop PC gaming rig showcase inside a tempered glass chassis with dual transparent liquid cooling acrylic hardline tubes illuminated with vivid violet ultraviolet coolant, ASUS ROG Strix GeForce RTX 4090 GPU mounted vertically, custom braided purple cables, matte black aluminum fittings, macro photography studio lighting, pure cyberpunk tech aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAP15SruE8HHBO08yUvGekPwMRio612M6Ouj-2_OVSelnY_adgvV1jjUZun2SisfRs0E561szApUD-fdtO1Z0uueTY2MEdISvpvCQaG5GlDriE6a6UjFgg-WnSqM9SMof0VDngOGF0PwoGGwCjIIb5872J7lHSPbcy8OfjmkMFhzIP-AQ2S9OWk7ooSWhWwW-_uc-2SIztuInVNiPxBgRaPcqNwTlvsUQ9m4_XdxCwP-xJfKQGLMDvT3w"/>
<!-- Overlay HUD telemetry elements -->
<div class="absolute bottom-3 left-3 flex flex-col gap-1 p-2.5 rounded-lg bg-surface-container-lowest/80 backdrop-blur-md">
<span class="font-label-sm text-label-sm text-outline">TITAN PUMP SPEED</span>
<span class="font-label-md text-label-md text-on-surface font-mono font-bold">4,200 RPM (PWM 92%)</span>
</div>
<div class="absolute bottom-3 right-3 flex items-center gap-2 p-2 rounded-lg bg-surface-container-lowest/80 backdrop-blur-md">
<span class="material-symbols-outlined text-primary text-[18px]">verified</span>
<span class="font-label-sm text-label-sm text-on-surface uppercase font-bold">BINNED SILICON</span>
</div>
</div>
<!-- Interactive Lighting Mode Switcher Bar -->
<div class="mt-4 pt-3 flex flex-col gap-2 relative z-10">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">AURA LIGHTING PRESET:</span>
<span class="font-label-sm text-label-sm text-primary font-mono uppercase" id="activePresetName">Cyberpunk Violet</span>
</div>
<div class="grid grid-cols-3 gap-2">
<button class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high transition-all text-on-surface font-label-sm text-label-sm" onclick="setPreset('violet')" type="button">
<span class="w-3 h-3 rounded-full bg-primary shadow-[0_0_8px_rgba(208,188,255,0.8)]"></span>
<span>Violet</span>
</button>
<button class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high transition-all text-on-surface font-label-sm text-label-sm" onclick="setPreset('cyan')" type="button">
<span class="w-3 h-3 rounded-full bg-tertiary shadow-[0_0_8px_rgba(76,215,246,0.8)]"></span>
<span>Neon Cyan</span>
</button>
<button class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high transition-all text-on-surface font-label-sm text-label-sm" onclick="setPreset('stealth')" type="button">
<span class="w-3 h-3 rounded-full bg-surface-bright"></span>
<span>Obsidian</span>
</button>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- 2. QUICK REPAIR STATUS SEARCH BAR (PROMINENT UTILITY SECTION) -->
<section class="max-w-7xl mx-auto px-6 lg:px-12 my-6">
<div class="relative rounded-2xl bg-surface-container p-6 sm:p-8 shadow-xl overflow-hidden">
<div class="absolute -top-12 -right-12 w-64 h-64 bg-tertiary/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
<div class="flex flex-col max-w-xl gap-1">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-tertiary text-[22px]">build_circle</span>
<h2 class="font-headline-md text-headline-md text-on-surface uppercase tracking-wide">Client Hardware Care &amp; Repair Tracking</h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant">
              Track real-time diagnostics, ultrasonic cooling block decontamination, nitrogen leak tests, and RMA overhaul milestones.
            </p>
</div>
<!-- Real-Time Search Bar Form -->
<div class="flex-1 max-w-xl">
<form class="flex flex-col sm:flex-row gap-2" onsubmit="handleTicketTrack(event)">
<div class="relative flex-1">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">precision_manufacturing</span>
<input class="w-full bg-surface-container-lowest pl-11 pr-4 py-3.5 rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-high transition-all font-mono" id="ticketInput" placeholder="Enter Repair Ticket ID (e.g., UPC-84920-RX)..." type="text" value="UPC-92841-RX"/>
</div>
