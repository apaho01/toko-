<!-- INLINE CLIENT MICRO-INTERACTIONS SCRIPT -->
<script>
    // 1. Rig Aura Lighting Preset Controller
    function setPreset(mode) {
      const glow = document.getElementById('ambientRgbGlow');
      const label = document.getElementById('activePresetName');
      if (mode === 'violet') {
        glow.className = "absolute inset-0 bg-primary/20 rounded-2xl blur-3xl transition-all duration-700 pointer-events-none";
        label.textContent = "Cyberpunk Violet";
        label.className = "font-label-sm text-label-sm text-primary font-mono uppercase";
      } else if (mode === 'cyan') {
        glow.className = "absolute inset-0 bg-tertiary/20 rounded-2xl blur-3xl transition-all duration-700 pointer-events-none";
        label.textContent = "Neon Cyan Flow";
        label.className = "font-label-sm text-label-sm text-tertiary font-mono uppercase";
      } else if (mode === 'stealth') {
        glow.className = "absolute inset-0 bg-transparent rounded-2xl blur-none transition-all duration-700 pointer-events-none";
        label.textContent = "Obsidian Stealth (Dark)";
        label.className = "font-label-sm text-label-sm text-outline font-mono uppercase";
      }
    }

    // 2. Repair Status Tracker Quick Input Simulation
    function handleTicketTrack(e) {
      e.preventDefault();
      const val = document.getElementById('ticketInput').value.trim();
      const resultBox = document.getElementById('ticketResultBox');
      if (val) {
        resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        resultBox.classList.add('scale-[1.01]');
        setTimeout(() => resultBox.classList.remove('scale-[1.01]'), 400);
      }
    }

    // 3. Component Filter Mechanism
    function filterCatalog(category) {
      const buttons = document.querySelectorAll('.catalog-tab');
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary-container', 'text-on-primary');
        btn.classList.add('bg-surface-container-high', 'text-on-surface');
      });
      event.currentTarget.classList.add('bg-primary-container', 'text-on-primary');
      event.currentTarget.classList.remove('bg-surface-container-high');

      const cards = document.querySelectorAll('#componentsGrid > div');
      cards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 4. Game Resolution FPS Switcher
    function setResolution(res) {
      const btn4k = document.getElementById('resBtn4K');
      const btn1440 = document.getElementById('resBtn1440');
      const fpsCyberpunk = document.getElementById('fpsCyberpunk');
      const fpsCod = document.getElementById('fpsCod');
      const fpsWukong = document.getElementById('fpsWukong');
      const fpsCs2 = document.getElementById('fpsCs2');

      const barCyber = document.getElementById('barCyberpunk');
      const barCod = document.getElementById('barCod');
      const barWukong = document.getElementById('barWukong');

      if (res === '4K') {
        btn4k.className = "px-4 py-1.5 rounded bg-primary text-on-primary font-label-md text-label-md uppercase font-bold transition-all";
        btn1440.className = "px-4 py-1.5 rounded text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase font-bold transition-all";
        fpsCyberpunk.textContent = "142";
        fpsCod.textContent = "218";
        fpsWukong.textContent = "124";
        fpsCs2.textContent = "540";
        barCyber.style.width = "72%";
        barCod.style.width = "88%";
        barWukong.style.width = "64%";
      } else {
        btn1440.className = "px-4 py-1.5 rounded bg-primary text-on-primary font-label-md text-label-md uppercase font-bold transition-all";
        btn4k.className = "px-4 py-1.5 rounded text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase font-bold transition-all";
        fpsCyberpunk.textContent = "196";
        fpsCod.textContent = "284";
        fpsWukong.textContent = "168";
        fpsCs2.textContent = "680+";
        barCyber.style.width = "90%";
        barCod.style.width = "98%";
        barWukong.style.width = "82%";
      }
    }
  </script>
